    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "customConditions": [
      "@hardcover/source"
    ]
  },
  "exclude": [
