---
import {Badge} from '@astrojs/starlight/components';

import {uCFirst, useTranslation} from "@/lib/utils";
import type { FrontmatterConfig } from '@/types';
import { Components } from "@/components";
import LocalDate from "@/components/LocalDate.astro";
import PrereleaseBanner from "@/components/SdkExplorer/PrereleaseBanner.astro";
import { prereleaseLabel } from "@/components/SdkExplorer/lib/releases";

// Pages outside api/ that should still show the API disclaimer banner.
const API_BANNER_ROUTES = ['contributing/api-docs'];

const {category, lastUpdated} = Astro.props.frontmatter as FrontmatterConfig;

const locale = Astro.currentLocale;
const route = Astro.locals.starlightRoute;
const slug = route?.locale ? route.id.replace(`${route.locale}/`, '') : route?.id ?? '';
const showApiBanner = slug.startsWith('api/') || API_BANNER_ROUTES.includes(slug);

// Every page of a pre-release SDK version (sdk/typescript/0.1/..., or a tagged
// release like 1.0.0-beta.2) says so.
const [, sdkLanguage, sdkVersion] = Astro.url.pathname.match(/\/sdk\/([^/]+)\/(\d+\.\d+)(\/|$)/) ?? [];
const prerelease = sdkLanguage && sdkVersion ? prereleaseLabel(sdkLanguage, sdkVersion) : undefined;

// Prefer Starlight's resolved last-updated (git commit date when there's no
// frontmatter override) over the raw frontmatter value.
const resolvedLastUpdated =
    route?.lastUpdated ??
    (lastUpdated ? new Date(lastUpdated) : undefined);
---

<div class="flex flex-auto flex-row justify-between mb-4">
    <p class="text-sm inline-block self-start" data-header-last-updated={resolvedLastUpdated ? '' : undefined}>
        {resolvedLastUpdated && (
                <>
                    {useTranslation('ui.lastUpdated', locale)} &nbsp; <LocalDate date={resolvedLastUpdated}/>
                </>
        )}
    </p>
    {category && (
            <Badge text={uCFirst(category)} variant="note" class="w-fit"/>
    )}
</div>
<hr>

{showApiBanner && <Components.banners.api locale={locale} client:only="react"/>}
{prerelease && <PrereleaseBanner language={sdkLanguage} label={prerelease} locale={locale}/>}

<slot/>
