---
/**
 * One function from the SDK's examples, as the SDK wrote and type-checks it:
 *   <SdkExample version="0.1" file="reading-progress" fn="readingProgress" />
 */
import { Code } from "@astrojs/starlight/components";
import { exampleCode } from "./lib/examples";

interface Props {
    version: string;
    file: string;
    fn: string;
}

const { version, file, fn } = Astro.props;
const code = exampleCode(version, file, fn);
const source = `https://github.com/hardcoverapp/community-sdk/blob/main/packages/typescript/examples/${file}.ts`;
---

<Code code={code} lang="ts" title={`${file}.ts`} wrap />
<p class="sdk-example-source"><a href={source}>See the whole example on GitHub</a></p>

<style>
    .sdk-example-source {
        margin-top: 0.4rem !important;
        font-size: 0.82rem;
    }
</style>
