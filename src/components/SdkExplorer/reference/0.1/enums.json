  "JournalEvent": {
    "type": "string",
    "field": "event",
    "notes": "The API accepts any of these from journal.add. Only notes and quotes are normally written by apps; the rest are journaled by the server as a side effect of library, reads, lists and prompts calls, so apps don't add them. A manual progress_updated merges into that day's entry.",
    "values": [
      {
        "id": "note",
        "key": "NOTE",
        "label": "Notes"
      },
      {
        "id": "quote",
        "key": "QUOTE",
        "label": "Quotes"
      },
      {
        "id": "progress_updated",
        "key": "PROGRESS_UPDATED",
        "label": "Progress updates",
        "doc": "Written by the server when you use reads.setProgress. A manual entry merges into that day's progress entry."
      },
      {
        "id": "rated",
        "key": "RATED",
        "label": "Ratings",
        "doc": "Written by the server when you use library.rate or library.update; adding it yourself duplicates it."
      },
      {
        "id": "reviewed",
        "key": "REVIEWED",
        "label": "Reviews",
        "doc": "Written by the server when you use library.update with a review; adding it yourself duplicates it."
      },
      {
        "id": "status_want_to_read",
        "key": "STATUS_WANT_TO_READ",
        "label": "Want to read",
        "doc": "Written by the server when you use library.add or library.setStatus; adding it yourself duplicates it."
      },
      {
        "id": "status_currently_reading",
        "key": "STATUS_CURRENTLY_READING",
        "label": "Started reading",
        "doc": "Written by the server when you use library.setStatus; adding it yourself duplicates it."
      },
      {
        "id": "status_read",
        "key": "STATUS_READ",
        "label": "Finished reading",
        "doc": "Written by the server when you use library.setStatus; adding it yourself duplicates it."
      },
      {
        "id": "status_paused",
        "key": "STATUS_PAUSED",
        "label": "Paused",
        "doc": "Written by the server when you use library.setStatus; adding it yourself duplicates it."
      },
      {
        "id": "status_stopped",
        "key": "STATUS_STOPPED",
        "label": "Stopped",
        "doc": "Written by the server when you use library.setStatus; adding it yourself duplicates it."
      },
      {
        "id": "user_book_read_started",
        "key": "USER_BOOK_READ_STARTED",
        "label": "Started an edition",
        "doc": "Written by the server when you use library.setStatus (Currently Reading starts a read); adding it yourself duplicates it."
      },
      {
        "id": "user_book_read_finished",
        "key": "USER_BOOK_READ_FINISHED",
        "label": "Finished an edition",
        "doc": "Written by the server when you use library.setStatus (Read finishes the read); adding it yourself duplicates it."
      },
      {
        "id": "list_book",
        "key": "LIST_BOOK",
        "label": "Added to a list",
        "doc": "Written by the server when you use lists.addBook or lists.addBooks; adding it yourself duplicates it."
      },
      {
        "id": "prompt_book",
        "key": "PROMPT_BOOK",
        "label": "Prompt answers",
        "doc": "Written by the server when a book is added to a prompt answer."
      },
      {
        "id": "referral_to",
        "key": "REFERRAL_TO",
        "label": "Recommendations sent",
        "doc": "Written by the server from a library entry's recommendedFor."
      },
      {
        "id": "referred_by",
        "key": "REFERRED_BY",
        "label": "Recommendations received",
        "doc": "Written by the server from a library entry's recommendedBy."
      }
    ]
  },
