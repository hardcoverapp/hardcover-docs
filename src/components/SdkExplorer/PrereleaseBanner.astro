---
/** Shown on every page of a pre-1.0 SDK version (sdk/<language>/0.x/...). */
import { useTokenTranslation, useTranslation } from "@/lib/utils";

interface Props {
    version: string;
    locale?: string;
}

const { version, locale = "en" } = Astro.props;

const text = String(
    useTokenTranslation("pages.sdk.prereleaseBanner.text", locale, {
        changelog: () => `<a href="/sdk/typescript/changelog/">{chunks}</a>`,
        issues: () => `<a href="https://github.com/hardcoverapp/community-sdk/issues" target="_blank" rel="noreferrer noopener">{chunks}</a>`,
    }),
).replace("{version}", `${version}.x`);
---

<aside class="rounded-lg border border-indigo-line bg-indigo-soft p-4 text-foreground mb-6" aria-labelledby="sdk-prerelease-title">
    <h5 id="sdk-prerelease-title" class="!mt-0 !text-primary">{useTranslation("pages.sdk.prereleaseBanner.title", locale)}</h5>
    <p set:html={text} />
</aside>
