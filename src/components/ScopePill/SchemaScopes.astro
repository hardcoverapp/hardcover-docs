---
/**
 * "Reading books needs read:catalog" at the top of a schema page, from
 * capabilities.json. Renders nothing for a type the API doesn't list.
 */
import { operationScope } from "@/data/queryScopes";
import { useTranslation } from "@/lib/utils";
import ScopePill from "./ScopePill.astro";

interface Props {
    typeName: string;
}

const { typeName } = Astro.props;
const locale = Astro.currentLocale;
const scope = operationScope(typeName);

const [before, after] = String(useTranslation("ui.scopes.readType", locale)).split("{type}");
---

{scope && (
    <>
        <p>{before}<code>{typeName}</code>{after} <ScopePill scope={scope} /></p>
        <p>
            Each example below lists the scopes it uses, and <a href="/api/graphql/actions/">Actions &amp; Scopes</a>
            lists every query and mutation.
        </p>
    </>
)}
